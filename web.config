<?xml version="1.0" encoding="UTF-8"?>
<!--
  إعداد IIS لنشر منصة مراقبة الجودة — كاك بنك
  الموقع: موقع ويب ثابت (Static) — لا يحتاج .NET أو قاعدة بيانات.
  ضع هذا الملف في جذر مجلد المنصة على الخادم.
-->
<configuration>
  <system.webServer>

    <!-- الصفحة الافتراضية -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>

    <!-- أنواع الملفات التي يحتاجها IIS صراحةً -->
    <staticContent>
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json; charset=utf-8" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript; charset=utf-8" />
      <remove fileExtension=".woff2" />
      <mimeMap fileExtension=".woff2" mimeType="font/woff2" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- ترويسات أمان أساسية -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
        <add name="Permissions-Policy" value="camera=(), microphone=(), geolocation=()" />
      </customHeaders>
    </httpProtocol>

    <!-- ضغط الاستجابات -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- رسالة خطأ مبسطة بدل صفحات IIS التفصيلية -->
    <httpErrors errorMode="DetailedLocalOnly" />

  </system.webServer>
</configuration>
